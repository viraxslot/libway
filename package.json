{
  "name": "libway",
  "version": "0.1.0",
  "description": "macOS tray app that tracks GitHub tool release versions",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac": "bash scripts/build-mac.sh",
    "install:mac": "bash scripts/install-mac.sh",
    "check:versions": "bash scripts/check-versions.sh",
    "changelog": "bash scripts/changelog.sh",
    "release:version": "bash scripts/release-version.sh",
    "release:publish": "bash scripts/release-publish.sh",
    "retag": "bash scripts/retag.sh",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
